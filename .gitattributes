# 저장소 안에서는 항상 LF로 통일 (Windows/Mac 협업 시 줄바꿈 충돌 방지)
* text=auto eol=lf

# 이미지·폰트는 바이너리로 취급 (깃이 내용을 건드리지 않도록)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.mp4  binary
*.mov  binary
*.woff binary
*.woff2 binary

# Windows 배치 파일은 CRLF 유지
*.bat text eol=crlf
